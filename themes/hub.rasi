/* hub.rasi -- the theme for the hub's list.
 *
 * Same palette as monochrome.rasi, which it is derived from; what differs is
 * how much fits on screen. The root shows pinned entries, folders AND the
 * hub's sections, so at twelve rows with generous padding the sections fell
 * off the bottom of a 1080p screen -- invisible, which defeats the point of
 * putting them there. Thirteen slightly tighter rows fit, and the window is
 * still `fixed-height: false`, so a short list does not pad itself out.
 *
 * The animations grid has its own theme (grid.rasi): it needs large
 * thumbnails, and rofi cannot restyle itself mid-session.
 */

* {
    bg-base:      #0a0a0a;   /* Deep black window background */
    bg-elevated:  #161616;   /* Dark grey -- search bar / message surface */
    bg-selected:  #ffffff;   /* Selected row: solid white, not a soft tint */
    fg-primary:   #ffffff;   /* White body text */
    fg-secondary: #666666;   /* Grey -- placeholder / prompt label */
    accent-text:  #000000;   /* Black text on the white selected row */
    border-color: #222222;   /* Window border */

    background-color: transparent;
    text-color:        @fg-primary;
    font:              "JetBrainsMono Nerd Font 11";
}

window {
    transparency:     "real";
    background-color: @bg-base;
    border:            1px;
    border-color:       @border-color;
    border-radius:      16px;
    padding:            20px;
    width:              620px;
    location:           center;
    anchor:              center;
}

mainbox {
    background-color: transparent;
    spacing: 15px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @bg-elevated;
    border-radius:     12px;
    padding:            12px 16px;
    spacing:            12px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:         @fg-secondary;
    vertical-align:     0.5;
}

entry {
    background-color: transparent;
    text-color:         @fg-primary;
    /* No placeholder text on purpose: it lives in the theme, which cannot
       be localised, and an English hint under a translated prompt and hint
       line reads as a bug. The magnifier in the prompt says enough. */
    placeholder-color:  @fg-secondary;
    vertical-align:     0.5;
}

message {
    background-color: @bg-elevated;
    border-radius:     12px;
    padding:            10px 14px;
    text-color:         @fg-primary;
}

textbox {
    background-color: transparent;
}

listview {
    background-color: transparent;
    spacing:            3px;
    lines:              13;
    cycle:              true;
    dynamic:             true;
    scrollbar:           false;
    fixed-height:        false;
    border:              0;
}

element {
    background-color: transparent;
    text-color:         @fg-primary;
    border-radius:      10px;
    padding:              7px 14px;
    spacing:             12px;
    orientation:         horizontal;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:         @fg-primary;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:         @accent-text;
}

element-text {
    vertical-align:    0.5;
    text-color:         inherit;
    background-color:  transparent;
}
